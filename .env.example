# === Front (Vite) ===
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# === Backend (Vercel functions / scripts) ===
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=                      # Vercel lo manda como Bearer a los crons
APP_BASE_URL=                     # ej: https://eiz-metrics.vercel.app (redirects de OAuth)
OAUTH_STATE_SECRET=               # secreto para firmar el state de OAuth (si falta usa el service role)

# === Modo legado (antes de migrar a multi-cuenta; luego se guardan en platform_credentials) ===
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
TIKTOK_MANUAL_UPLOAD_TOKEN=       # solo modo legado; ROTAR: el valor anterior estuvo commiteado

# === OAuth (Fase A/C) ===
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === Conector MCP para claude.ai (docs/MCP.md) ===
MCP_TOKEN=                        # secreto que manda el conector como Authorization: Bearer
MCP_ACCOUNT_SLUG=                 # opcional: slug de la cuenta a exponer (si hay una sola, no hace falta)

# === IA (reporte semanal, estrategia, análisis de video) ===
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# === Competencia de TikTok (Scrape Creators, créditos prepagos) ===
SCRAPE_CREATORS_API_KEY=
SCRAPE_CREATORS_BUDGET=120            # tope de créditos por corrida de refresh
